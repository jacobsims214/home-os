# Build context is apps/api (release.yml, deploy/docker-compose.yml). The
# Dockerfile runs COPY . ., so keep local artefacts out of the image.
Dockerfile
.dockerignore
.env
.env.*
**/*.log
**/*.test
**/*.out
coverage/
tmp/
bin/
.DS_Store

# Local `go build` binary (untracked in #2786).
/api
/home-os
