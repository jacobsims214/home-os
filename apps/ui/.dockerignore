# Build context is apps/ui (release.yml, deploy/docker-compose.yml). The
# Dockerfile runs `npm install` and `next build` in the image, so host
# node_modules and build output must not be copied over them.
Dockerfile
.dockerignore
node_modules
.next
out
coverage
playwright-report
test-results
blob-report
*.tsbuildinfo
.env
.env.*
!.env.example
*.log
.DS_Store
# next-pwa output regenerated by every production build.
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map
