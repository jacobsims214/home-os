# ============================================
# Home OS — Environment Variables
# ============================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# All services read configuration from environment
# variables. No config files in production.
# ============================================

# --- Postgres ---
# Connection string for the core API, calendar service, and worker.
# The docker-compose stack runs Postgres 16 on localhost:5432.
DATABASE_URL=postgres://homeos:homeos@localhost:5433/homeos?sslmode=disable
POSTGRES_PASSWORD=homeos

# --- Typesense (Search) ---
# Typesense runs locally via Docker Compose. The API key is the
# admin key used for creating collections and indexing data.
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8109
TYPESENSE_API_KEY=local-dev-key

# --- MinIO (Object Storage) ---
# MinIO provides S3-compatible object storage for document uploads,
# backups, and media. The console UI is available at localhost:9001.
MINIO_ENDPOINT=localhost:9002
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_USE_SSL=false

# --- Auth ---
# Secret key used to sign and verify JWT tokens for API authentication.
# Change this to a strong random value in production.
JWT_SECRET=local-dev-secret-change-in-prod

# --- Calendar (CalDAV) ---
# Secret used by the calendar service for CalDAV authentication.
CALENDAR_SECRET=local-calendar-secret

# --- Integration Encryption ---
# 32-byte key used to encrypt integration credentials (API tokens,
# passwords) before storing them in the database. Must be exactly
# 32 characters.
INTEGRATION_ENCRYPTION_KEY=local-encryption-key-32-chars-xx

# --- Demo Mode ---
# Set to true to seed demo data (admin@homeos.demo / demo1234) on API startup.
# Idempotent — safe to leave on; won't duplicate data.
DEMO_MODE=false

# --- External Integrations (Optional) ---
# These services are NOT included in the Docker Compose stack.
# Set values to connect to existing instances, or leave empty
# to skip integration features during local development.

# Paperless-ngx — document management
PAPERLESS_URL=
PAPERLESS_TOKEN=

# Vaultwarden — self-hosted password manager
VAULTWARDEN_URL=

# Home Assistant — home automation platform
HOMEASSISTANT_URL=
HOMEASSISTANT_TOKEN=
