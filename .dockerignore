# Build context for root-context images (apps/api, apps/worker,
# apps/calendar; see release.yml and deploy/docker-compose.yml). Allowlist: exclude everything,
# then re-include only the modules those Dockerfiles COPY. This keeps
# .worktrees/, .git, .env*, node_modules, .next, tools/ and every other
# local artefact out of the context by default.
#
# mcp and ui build from their own directories (context apps/<name>) and
# packages/db from packages/db; those builds read their own .dockerignore,
# not this one.
#
# Adding a root-context image that needs another directory? Re-include it
# here, or the COPY fails with "not found".

*

!packages/icalx/
!apps/api/
!apps/worker/
!apps/calendar/

# Re-exclude local artefacts inside the re-included modules.
**/.git
**/.env
**/.env.*
**/node_modules
**/coverage
**/tmp
**/*.log
**/*.test
**/*.out
**/bin
**/.DS_Store

# Per-module Go binaries left by `go build` (untracked in #2786); images
# compile their own binary in-container.
apps/api/api
apps/api/home-os
apps/calendar/calendar
apps/worker/worker
